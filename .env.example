# GEMINI_API_KEY: Required for Google Cloud Gemini models and Agent runtime.
# Automatically injected or configured via AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PARALLEL_API_KEY: Required for live Parallel Search tool invocation.
# Partner integration for Google Cloud Agentic Cinema hackathon.
# Obtain from https://platform.parallel.ai
PARALLEL_API_KEY="MY_PARALLEL_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier.
# Defaults to "gemini-3.8-flash" (current Google Cloud Gen AI model).
GEMINI_MODEL="gemini-3.8-flash"

# GOOGLE_CLOUD_PROJECT: Optional GCP project ID when operating in Vertex AI Agent mode.
GOOGLE_CLOUD_PROJECT="my-gcp-project-id"

# GOOGLE_CLOUD_LOCATION: Optional GCP region (e.g. us-central1).
GOOGLE_CLOUD_LOCATION="us-central1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
